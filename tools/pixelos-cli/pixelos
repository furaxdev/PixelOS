#!/usr/bin/env bash
# pixelos-cli — thin wrapper around repo/breakfast/brunch/fastboot for the PixelOS build.
# Must be run on a real Linux build host (250GB+ disk, 16GB+ RAM). See docs/GETTING_STARTED.md.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
SRC_DIR="${PIXELOS_SRC_DIR:-$HOME/pixelos-src}"
MANIFEST_URL="https://github.com/LineageOS/android.git"
MANIFEST_BRANCH="lineage-16.0"
KEYS_DIR="${PIXELOS_KEYS_DIR:-$HOME/.pixelos-keys}"

usage() {
  cat <<'EOF'
pixelos - PixelOS build helper

Usage:
  pixelos doctor              Check the build host meets AOSP/LineageOS requirements
  pixelos init                Install `repo`, verify java/git, set up ccache
  pixelos sync                repo init + repo sync (source tree lives outside this repo)
  pixelos device <codename>   breakfast <codename> (fetch/select target config)
  pixelos build <codename> [variant]   brunch <codename> (variant: eng|userdebug|user, default userdebug)
  pixelos flash                Print fastboot/Odin flashing steps for the current target
  pixelos keys                 Generate a local release signing keystore (never committed)
  pixelos launcher-build       Build the Lawnchair fork via Gradle, copy the APK into vendor/pixelos/launcher
  pixelos clean                mka clean in the source tree
  pixelos swap-setup [GB]      Create+enable a swapfile (default 24GB) — see below, matters a lot under 16GB RAM
  pixelos distcc-check         Verify configured distcc helpers are actually reachable and being used

Environment overrides:
  PIXELOS_SRC_DIR       Where the AOSP/LineageOS source tree lives (default: ~/pixelos-src)
  PIXELOS_KEYS_DIR      Where signing keys are generated (default: ~/.pixelos-keys)
  PIXELOS_JOBS          Parallel build jobs for sync/build (default: nproc). Lower this (e.g. 2) on
                         low-RAM hosts — fewer concurrent compile/link jobs means less peak memory,
                         at the cost of build time. See 'pixelos doctor' for a host-specific value.
  PIXELOS_DISTCC_HOSTS  Space-separated distcc helper hosts (e.g. "192.168.1.50/4") to offload
                         compile jobs to. Unset by default — see docs/DISTCC_SETUP.md before setting
                         this, there's real one-time setup on both machines first.

On a host with under 16GB RAM, the OOM killer can and will kill the build mid-link without warning
(some linking steps alone want several GB). 'pixelos doctor' checks your swap and tells you whether
you need more; 'pixelos swap-setup' sets it up. Swap doesn't make the build fast, it makes it *finish*
instead of getting killed — expect it to lean on disk heavily near the memory ceiling, which is also
why an SSD matters more on a low-RAM host, not less.
EOF
}

need_src_dir() {
  if [[ ! -d "$SRC_DIR/.repo" ]]; then
    echo "error: no synced source tree at $SRC_DIR — run 'pixelos sync' first" >&2
    exit 1
  fi
}

cmd_doctor() {
  local ok=1
  echo "== pixelos doctor =="

  local disk_avail_kb
  disk_avail_kb=$(df -Pk "$HOME" | awk 'NR==2{print $4}')
  local disk_avail_gb=$((disk_avail_kb / 1024 / 1024))
  if (( disk_avail_gb < 250 )); then
    echo "[FAIL] free disk under \$HOME: ${disk_avail_gb}GB (need 250GB+)"; ok=0
  else
    echo "[ OK ] free disk under \$HOME: ${disk_avail_gb}GB"
  fi

  local mem_kb mem_gb swap_kb swap_gb
  mem_kb=$(awk '/MemTotal/{print $2}' /proc/meminfo 2>/dev/null || echo 0)
  mem_gb=$((mem_kb / 1024 / 1024))
  swap_kb=$(awk '/SwapTotal/{print $2}' /proc/meminfo 2>/dev/null || echo 0)
  swap_gb=$((swap_kb / 1024 / 1024))

  if (( mem_gb < 16 )); then
    echo "[WARN] RAM: ${mem_gb}GB (16GB+ recommended — the build WILL get OOM-killed on some steps without enough swap as a safety net)"
    if (( mem_gb + swap_gb < 16 )); then
      local need_gb=$((16 - mem_gb))
      echo "[FAIL] swap: ${swap_gb}GB (RAM+swap = $((mem_gb + swap_gb))GB, under the 16GB floor) — run: pixelos swap-setup ${need_gb}"
      ok=0
    else
      echo "[ OK ] swap: ${swap_gb}GB (RAM+swap = $((mem_gb + swap_gb))GB, covers the 16GB floor — builds will lean on disk, not crash)"
    fi
    echo "[HINT] also set PIXELOS_JOBS to something low (e.g. 2) to reduce peak memory per build — see 'pixelos help'"
  else
    echo "[ OK ] RAM: ${mem_gb}GB"
  fi

  for tool in git python3 java repo; do
    if command -v "$tool" >/dev/null 2>&1; then
      echo "[ OK ] $tool found: $(command -v "$tool")"
    else
      echo "[FAIL] $tool not found"; ok=0
    fi
  done

  if (( ok == 1 )); then
    echo "Host looks ready. Run 'pixelos init' next."
  else
    echo "Fix the FAIL items above before continuing."
    exit 1
  fi
}

cmd_init() {
  mkdir -p "$HOME/bin"
  if ! command -v repo >/dev/null 2>&1; then
    echo "Installing repo tool to $HOME/bin/repo ..."
    curl -fsSL https://storage.googleapis.com/git-repo-downloads/repo -o "$HOME/bin/repo"
    chmod a+x "$HOME/bin/repo"
    echo "Add \$HOME/bin to PATH if not already (e.g. in ~/.bashrc): export PATH=\"\$HOME/bin:\$PATH\""
  else
    echo "repo already installed: $(command -v repo)"
  fi

  if ! git config --global user.email >/dev/null 2>&1; then
    echo "No git identity configured (repo requires one)."
    read -rp "git user.name: " gname
    read -rp "git user.email: " gemail
    git config --global user.name "$gname"
    git config --global user.email "$gemail"
  fi

  if ! command -v ccache >/dev/null 2>&1; then
    echo "[WARN] ccache not found — installs will still work but rebuilds will be slower. Install via your distro's package manager."
  fi

  echo "init done."
}

cmd_sync() {
  mkdir -p "$SRC_DIR"
  cd "$SRC_DIR"
  if [[ ! -d .repo ]]; then
    repo init -u "$MANIFEST_URL" -b "$MANIFEST_BRANCH"
  fi
  mkdir -p .repo/local_manifests
  cp "$REPO_ROOT"/manifests/local_manifests/*.xml .repo/local_manifests/
  repo sync -c -j"${PIXELOS_JOBS:-$(nproc)}"
  link_vendor_pixelos
  echo "sync done. Source tree at $SRC_DIR"
}

link_vendor_pixelos() {
  # vendor/pixelos isn't a `repo`-managed project — it lives in this repo and gets symlinked in,
  # so `breakfast`/`lunch` can find our product makefiles and RRO packages.
  mkdir -p "$SRC_DIR/vendor"
  ln -sfn "$REPO_ROOT/vendor/pixelos" "$SRC_DIR/vendor/pixelos"
}

cmd_device() {
  local codename="${1:?usage: pixelos device <codename>}"
  need_src_dir
  link_vendor_pixelos
  cd "$SRC_DIR"
  # shellcheck disable=SC1091
  source build/envsetup.sh
  breakfast "$codename"
}

setup_distcc_env() {
  [[ -z "${PIXELOS_DISTCC_HOSTS:-}" ]] && return 0
  if ! command -v distcc >/dev/null 2>&1; then
    echo "error: PIXELOS_DISTCC_HOSTS is set but 'distcc' isn't installed on this (master) machine — sudo apt-get install distcc" >&2
    exit 1
  fi
  echo "distcc enabled, helpers: $PIXELOS_DISTCC_HOSTS"
  export DISTCC_HOSTS="localhost $PIXELOS_DISTCC_HOSTS"
  # ccache calls distcc on a cache miss instead of the compiler directly — this is a ccache-native
  # feature (CCACHE_PREFIX), so it applies whether the underlying build is Make or Soong/Ninja driven.
  if command -v ccache >/dev/null 2>&1; then
    export CCACHE_PREFIX=distcc
  else
    echo "[WARN] ccache not found — distcc will still work but you lose the local build-cache benefit entirely. Run 'pixelos init' first."
  fi
}

cmd_build() {
  local codename="${1:?usage: pixelos build <codename> [variant]}"
  local variant="${2:-userdebug}"
  need_src_dir
  cd "$SRC_DIR"
  # shellcheck disable=SC1091
  source build/envsetup.sh
  setup_distcc_env
  # MAKEFLAGS is honored by GNU Make regardless of how brunch/soong_ui invoke it underneath —
  # more version-portable than guessing whether brunch forwards a -jN argument itself.
  if [[ -n "${PIXELOS_JOBS:-}" ]]; then
    echo "Capping build parallelism at PIXELOS_JOBS=$PIXELOS_JOBS (lower peak memory, slower build)"
    export MAKEFLAGS="-j${PIXELOS_JOBS}"
  fi
  brunch "${codename}-${variant}"
}

cmd_distcc_check() {
  if [[ -z "${PIXELOS_DISTCC_HOSTS:-}" ]]; then
    echo "PIXELOS_DISTCC_HOSTS is not set — nothing to check. See docs/DISTCC_SETUP.md." >&2
    exit 1
  fi
  if ! command -v distcc >/dev/null 2>&1; then
    echo "error: distcc not installed on this machine — sudo apt-get install distcc" >&2
    exit 1
  fi
  echo "Checking each configured helper accepts connections (not that compilation works — just TCP reachability):"
  for host_spec in $PIXELOS_DISTCC_HOSTS; do
    # DISTCC_HOSTS syntax: host[:port][/jobs] — strip the /jobs suffix first, THEN split host:port
    # (doing it in the other order mis-parses "host:port/jobs" since the jobs count follows the port).
    local hostport="${host_spec%%/*}"
    local host port
    if [[ "$hostport" == *:* ]]; then
      host="${hostport%%:*}"
      port="${hostport##*:}"
    else
      host="$hostport"
      port=3632
    fi
    if timeout 3 bash -c "cat < /dev/null > /dev/tcp/$host/$port" 2>/dev/null; then
      echo "[ OK ] $host:$port reachable"
    else
      echo "[FAIL] $host:$port NOT reachable — is distccd running there? firewall open? see tools/distcc/setup-helper.sh"
    fi
  done
  echo
  echo "For a real end-to-end check (confirms the toolchain versions actually match, not just that"
  echo "the port is open), run a build with DISTCC_VERBOSE=1 and watch 'distccmon-text 1' in another"
  echo "terminal — jobs silently falling back to localhost usually mean a toolchain mismatch, see"
  echo "tools/distcc/sync-toolchain.sh."
}

cmd_flash() {
  cat <<'EOF'
General flashing notes (always check docs/DEVICE_SUPPORT.md for your exact target first):

x86_64 / VirtualBox target:
  Import out/target/product/pixelos_x86_64/*.iso as a new VirtualBox VM
  (EFI enabled, 2 vCPU / 4GB RAM minimum) and boot it directly. No flashing needed.

matissewifi (Galaxy Tab 4 SM-T530), physical device:
  1. Flash a matching TWRP recovery via Odin first (stock bootloader doesn't do fastboot here).
  2. Boot into recovery, wipe data/cache per a clean-flash checklist.
  3. adb sideload out/target/product/matissewifi/pixelos-*.zip
  4. Reboot; first boot can take 10+ minutes on this hardware.
EOF
}

cmd_keys() {
  mkdir -p "$KEYS_DIR"
  if [[ -f "$KEYS_DIR/releasekey.pk8" ]]; then
    echo "Keys already exist at $KEYS_DIR — not overwriting."
    exit 0
  fi
  need_src_dir
  local subject="/C=US/ST=State/L=City/O=PixelOS/OU=PixelOS/CN=PixelOS/emailAddress=pixelos@example.com"
  for k in releasekey platform shared media networkstack; do
    "$SRC_DIR/development/tools/make_key" "$KEYS_DIR/$k" "$subject"
  done
  echo "Keys generated at $KEYS_DIR (kept out of git via .gitignore — back this up somewhere safe, losing it means you can never sign an OTA update to a device running your old key)."
}

cmd_clean() {
  need_src_dir
  cd "$SRC_DIR"
  # shellcheck disable=SC1091
  source build/envsetup.sh
  mka clean
}

cmd_swap_setup() {
  local size_gb="${1:-24}"
  local swapfile="/swapfile-pixelos"

  if [[ "$(id -u)" -ne 0 ]] && ! sudo -n true 2>/dev/null; then
    echo "error: needs root (creating a swapfile under / and enabling it via swapon) — re-run with sudo, or ensure passwordless sudo" >&2
    exit 1
  fi

  if swapon --show=NAME --noheadings 2>/dev/null | grep -qx "$swapfile"; then
    echo "$swapfile is already active. Current swap:"
    swapon --show
    exit 0
  fi

  local avail_kb avail_gb
  avail_kb=$(df -Pk / | awk 'NR==2{print $4}')
  avail_gb=$((avail_kb / 1024 / 1024))
  if (( avail_gb < size_gb + 20 )); then
    echo "error: only ${avail_gb}GB free on / — refusing to carve out ${size_gb}GB for swap without at least 20GB headroom left over. Free up space or pass a smaller size." >&2
    exit 1
  fi

  echo "Creating a ${size_gb}GB swapfile at $swapfile (this can take a few minutes)..."
  if ! sudo fallocate -l "${size_gb}G" "$swapfile" 2>/dev/null; then
    echo "fallocate unsupported on this filesystem, falling back to dd (slower)..."
    sudo dd if=/dev/zero of="$swapfile" bs=1M count=$((size_gb * 1024)) status=progress
  fi
  sudo chmod 600 "$swapfile"
  sudo mkswap "$swapfile"
  sudo swapon "$swapfile"

  echo "Swap active:"
  swapon --show

  if ! grep -q "^$swapfile " /etc/fstab 2>/dev/null; then
    read -rp "Persist this swapfile across reboots via /etc/fstab? [y/N] " persist
    if [[ "$persist" =~ ^[Yy]$ ]]; then
      echo "$swapfile none swap sw 0 0" | sudo tee -a /etc/fstab >/dev/null
      echo "Added to /etc/fstab."
    else
      echo "Not persisted — it'll disappear on reboot, re-run 'pixelos swap-setup' after if needed."
    fi
  fi
}

cmd_launcher_build() {
  need_src_dir
  local lawnchair_dir="$SRC_DIR/packages/apps/Lawnchair"
  if [[ ! -d "$lawnchair_dir" ]]; then
    echo "error: $lawnchair_dir not found — run 'pixelos sync' first (pulls it via manifests/local_manifests/lawnchair.xml)" >&2
    exit 1
  fi
  if ! command -v java >/dev/null 2>&1; then
    echo "error: no JDK found — Lawnchair's Gradle build needs one separate from the AOSP toolchain" >&2
    exit 1
  fi
  echo "Lawnchair's Gradle assemble task name changes between releases — listing available tasks:"
  (cd "$lawnchair_dir" && ./gradlew tasks --group lawnchair)
  echo
  echo "Run the release assemble task yourself (e.g. ./gradlew assembleXyzRelease from $lawnchair_dir),"
  echo "then copy the resulting APK to: $REPO_ROOT/vendor/pixelos/launcher/prebuilt/Lawnchair.apk"
  echo "See vendor/pixelos/launcher/README.md for why this isn't fully automated here."
}

main() {
  local cmd="${1:-}"
  [[ $# -gt 0 ]] && shift || true
  case "$cmd" in
    doctor) cmd_doctor "$@" ;;
    init) cmd_init "$@" ;;
    sync) cmd_sync "$@" ;;
    device) cmd_device "$@" ;;
    build) cmd_build "$@" ;;
    flash) cmd_flash "$@" ;;
    keys) cmd_keys "$@" ;;
    launcher-build) cmd_launcher_build "$@" ;;
    clean) cmd_clean "$@" ;;
    swap-setup) cmd_swap_setup "$@" ;;
    distcc-check) cmd_distcc_check "$@" ;;
    -h|--help|help|"") usage ;;
    *) echo "unknown command: $cmd" >&2; usage; exit 1 ;;
  esac
}

main "$@"
